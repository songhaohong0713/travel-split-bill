.screen { padding: 30rpx 48rpx calc(190rpx + env(safe-area-inset-bottom)); }
.card { background:var(--bg-surface); border-radius:44rpx; padding:40rpx; margin-bottom:28rpx; }
.row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.title { display:block; font-size:52rpx; font-weight:700; line-height:1.45; }
.section-title { font-size:34rpx; font-weight:700; }
.muted { color:var(--text-secondary); font-size:26rpx; line-height:1.6; }
.block { display:block; }
.heading { margin-bottom:32rpx; }
.primary,.secondary { margin:0; border-radius:32rpx; font-size:30rpx; font-weight:600; min-height:108rpx; line-height:108rpx; padding:0 24rpx; }
.primary { background:var(--text-primary); color:var(--bg-surface); }
.secondary { background:var(--bg-surface); border:1rpx solid var(--bg-subtle); color:var(--text-primary); }
button::after { border:0; }
.bottom-bar { position:fixed; z-index:20; left:0; right:0; bottom:0; background:var(--bg-page); padding:24rpx 48rpx calc(26rpx + env(safe-area-inset-bottom)); }
.bottom-bar .primary { flex:1; }
.bottom-note { display:block; text-align:center; font-size:23rpx; color:var(--text-secondary); padding-bottom:16rpx; }
.badge,.chip { display:inline-block; border-radius:40rpx; padding:9rpx 22rpx; font-size:24rpx; background:var(--brand-green-subtle); color:var(--brand-green); white-space:nowrap; }
.badge.pending { background:var(--status-danger-bg); color:var(--status-danger); }
.badge.recording { background:var(--bg-page); color:var(--text-secondary); }
.danger,.error { color:var(--status-danger); }
.error { display:block; font-size:26rpx; line-height:1.6; margin:20rpx 0; }
.field-label { display:block; font-size:25rpx; color:var(--text-secondary); margin-bottom:12rpx; }
.input { background:var(--bg-page); border-radius:28rpx; padding:24rpx 30rpx; font-size:30rpx; min-height:48rpx; }
.divider { border-bottom:1rpx solid var(--bg-subtle); }
.link { color:var(--brand-green); font-size:27rpx; }
.empty { text-align:center; padding:48rpx 0; }
.hero { background:var(--brand-green); color:var(--bg-surface); }
.hero .muted { color:var(--brand-green-border); }
.hero-value { display:block; font-size:72rpx; font-weight:700; margin:20rpx 0 8rpx; }
.hero-value .unit { font-size:25rpx; font-weight:400; margin-left:12rpx; }
.hero .secondary { color:var(--brand-green); margin-top:26rpx; min-height:92rpx; line-height:92rpx; }
.sheet-cover { position:fixed; z-index:50; inset:0; background:rgba(0,0,0,.35); display:flex; align-items:flex-end; }
.sheet { width:100%; box-sizing:border-box; background:var(--bg-surface); border-radius:40rpx 40rpx 0 0; padding:36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom)); max-height:80vh; overflow:auto; }
.sheet-option { padding:28rpx 8rpx; border-bottom:1rpx solid var(--bg-subtle); font-size:32rpx; }

.badge.pending,.badge.payer_marked,.badge.payable,.badge.receivable{background:var(--status-pending-bg);color:var(--status-pending)}
.primary:disabled{background:var(--bg-disabled);color:var(--text-placeholder)}
.amount-input,.hero-value,.summary-value,.transfer-amount,.table-row{font-variant-numeric:tabular-nums}
.bottom-bar{background:var(--bg-page);padding-bottom:max(28rpx,env(safe-area-inset-bottom))}
.screen{padding-bottom:calc(200rpx + env(safe-area-inset-bottom))}
.loading-card,.skeleton{background:var(--bg-surface);color:var(--text-secondary)}
.loading-card::before{content:'';display:block;height:100rpx;border-radius:var(--radius-input);background:var(--bg-subtle);margin-bottom:24rpx}

.field{margin:28rpx 0}.sheet .field-label{margin-bottom:12rpx}
