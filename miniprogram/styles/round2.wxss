.screen { padding: 30rpx 48rpx calc(190rpx + env(safe-area-inset-bottom)); }
.card { background:#FFFFFF; border-radius:44rpx; padding:40rpx; margin-bottom:28rpx; }
.row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.title { display:block; font-size:52rpx; font-weight:700; line-height:1.45; }
.section-title { font-size:34rpx; font-weight:700; }
.muted { color:#8B8B85; font-size:26rpx; line-height:1.6; }
.block { display:block; }
.heading { margin-bottom:32rpx; }
.primary,.secondary { margin:0; border-radius:32rpx; font-size:30rpx; font-weight:600; min-height:108rpx; line-height:108rpx; padding:0 24rpx; }
.primary { background:#1A1A17; color:#FFFFFF; }
.secondary { background:#FFFFFF; border:1rpx solid #ECE8E1; color:#1A1A17; }
button::after { border:0; }
.bottom-bar { position:fixed; z-index:20; left:0; right:0; bottom:0; background:#F6F4F0; padding:24rpx 48rpx calc(26rpx + env(safe-area-inset-bottom)); }
.bottom-bar .primary { flex:1; }
.bottom-note { display:block; text-align:center; font-size:23rpx; color:#8B8B85; padding-bottom:16rpx; }
.badge,.chip { display:inline-block; border-radius:40rpx; padding:9rpx 22rpx; font-size:24rpx; background:#E8EFEB; color:#2F5D4E; white-space:nowrap; }
.badge.pending { background:#F6E5E0; color:#B5523B; }
.badge.recording { background:#F6F4F0; color:#8B8B85; }
.danger,.error { color:#B5523B; }
.error { display:block; font-size:26rpx; line-height:1.6; margin:20rpx 0; }
.field-label { display:block; font-size:25rpx; color:#8B8B85; margin-bottom:12rpx; }
.input { background:#F6F4F0; border-radius:28rpx; padding:24rpx 30rpx; font-size:30rpx; min-height:48rpx; }
.divider { border-bottom:1rpx solid #ECE8E1; }
.link { color:#2F5D4E; font-size:27rpx; }
.empty { text-align:center; padding:48rpx 0; }
.hero { background:#2F5D4E; color:#FFFFFF; }
.hero .muted { color:#D1DED7; }
.hero-value { display:block; font-size:72rpx; font-weight:700; margin:20rpx 0 8rpx; }
.hero-value .unit { font-size:25rpx; font-weight:400; margin-left:12rpx; }
.hero .secondary { color:#2F5D4E; margin-top:26rpx; min-height:92rpx; line-height:92rpx; }
.sheet-cover { position:fixed; z-index:50; inset:0; background:rgba(0,0,0,.35); display:flex; align-items:flex-end; }
.sheet { width:100%; box-sizing:border-box; background:#FFFFFF; border-radius:40rpx 40rpx 0 0; padding:36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom)); max-height:80vh; overflow:auto; }
.sheet-option { padding:28rpx 8rpx; border-bottom:1rpx solid #ECE8E1; font-size:32rpx; }
