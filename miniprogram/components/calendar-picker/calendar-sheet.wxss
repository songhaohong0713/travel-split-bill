:host {display:block;}
.calendar-trigger {padding:12rpx 0;color:#92938A;font-size:26rpx;line-height:1.8;text-align:left;}
.calendar-date-row {display:flex;justify-content:space-between;gap:16rpx;padding:12rpx 0;}
.date-value {color:#2F5D50;}
.calendar-range.compact {display:flex;justify-content:space-between;gap:24rpx;}
.compact .calendar-date-row {display:flex;flex-direction:column;gap:6rpx;}
.calendar-single {text-align:center;}
.calendar-single .calendar-trigger-hint {color:#2F5D50;font-size:24rpx;}
.calendar-mask {position:fixed;top:0;right:0;bottom:0;left:0;z-index:10000;background:rgba(0,0,0,.35);display:flex;align-items:flex-end;}
.calendar-sheet {width:100%;box-sizing:border-box;background:#F7F5F1;border-radius:36rpx 36rpx 0 0;padding:30rpx 32rpx calc(26rpx + env(safe-area-inset-bottom));color:#1D1D19;text-align:left;}
.calendar-heading {display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:600;}
.calendar-close {background:transparent;font-size:26rpx;color:#777;margin:0;padding:0 16rpx;font-weight:400;}
.calendar-close::after,.calendar-nav::after,.calendar-confirm::after {border:none;}
.calendar-selection {font-size:27rpx;color:#2F5D50;margin:16rpx 0 22rpx;min-height:40rpx;}
.calendar-month {display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;}
.calendar-month .calendar-month-title {flex:1;text-align:center;font-size:30rpx;font-weight:600;}
.calendar-month .calendar-nav {background:transparent;color:#2F5D50;font-size:38rpx;width:64rpx;padding:0;margin:0;line-height:1.5;}
.calendar-grid {display:flex;flex-wrap:wrap;}
.calendar-week,.calendar-day {width:14.285714%;text-align:center;box-sizing:border-box;}
.calendar-week {font-size:24rpx;color:#92938A;padding:12rpx 0;}
.calendar-day {height:76rpx;line-height:76rpx;font-size:29rpx;border-radius:18rpx;}
.calendar-day.in-range {background:#E8F0EC;border-radius:0;}
.calendar-day.today {font-weight:700;text-decoration:underline;}
.calendar-day.selected {background:#2F5D50;color:#fff;border-radius:18rpx;}
.calendar-hint {display:block;color:#92938A;font-size:24rpx;margin:20rpx 0;}
.calendar-confirm {background:#1D1D19;color:#fff;border-radius:26rpx;font-size:30rpx;}
.calendar-confirm-disabled {background:#E5E3DD;color:#92938A;}

.calendar-mask .calendar-sheet .calendar-confirm{display:flex;align-items:center;justify-content:center;width:100%;height:100rpx;min-height:100rpx;line-height:100rpx;padding:0 24rpx;margin:0;background:#1A1A17!important;color:#FFFFFF!important;box-sizing:border-box}.calendar-confirm-text{color:#FFFFFF;font-size:30rpx;font-weight:600}.calendar-mask .calendar-sheet .calendar-confirm-disabled{background:#E3DFD7!important}.calendar-confirm-disabled .calendar-confirm-text{color:#6B6A64}

.calendar-trigger.active{color:#FFFFFF}
