<view class="page"><text class="title">结算预览</text><text class="hint">以下建议已尽量减少转账次数。</text><block wx:if="{{transfers.length}}"><view wx:for="{{transfers}}" wx:key="from_participant_id" class="transfer"><text>{{item.from_participant_id}} → {{item.to_participant_id}}</text><text>{{item.amount.amount}} {{item.amount.currency}}</text></view></block><view wx:else class="empty">暂无需要转账的余额</view><button class="primary" bindtap="publish" loading="{{publishing}}" disabled="{{published || publishing}}">{{published ? "已发布结算版本" : "发布结算版本"}}</button><view class="share-card"><text class="label">链接有效期</text><picker range="{{expiryDays}}" value="{{expiryIndex}}" bindchange="onExpiryChange"><view class="picker">{{expiryDays[expiryIndex]}} 天</view></picker><button class="secondary" bindtap="share" loading="{{sharing}}" disabled="{{!published || sharing}}">创建分享链接</button><view wx:if="{{shareUrl}}" class="link-result"><text class="label">分享链接已复制</text><text class="share-url" selectable="true">{{shareUrl}}</text><text class="expires">有效至 {{shareExpiresAt}}</text><button class="copy" bindtap="copyShareLink">复制链接</button></view></view></view>