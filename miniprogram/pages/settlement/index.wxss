.page { padding: 48rpx 40rpx; background: #F3F0E8; min-height: 100vh; }.title { display:block; font-size:56rpx; font-weight:700; color:#173C48; }.hint { display:block; margin:16rpx 0 36rpx; color:#617176; }.transfer { margin:18rpx 0; padding:28rpx; display:flex; justify-content:space-between; background:#FFFDF6; border-radius:16rpx; color:#173C48; }.empty { padding:48rpx 0; color:#617176; text-align:center; }.primary,.secondary { margin-top:24rpx; border-radius:16rpx; }.primary { background:#173C48; color:#FFFDF6; }.secondary { background:#D9E5DE; color:#173C48; }.share-card { margin-top:40rpx; padding-top:8rpx; border-top:1rpx solid #D5D4CC; }.label { display:block; margin-top:24rpx; color:#617176; font-size:24rpx; }.picker { margin-top:12rpx; padding:22rpx 24rpx; color:#173C48; background:#FFFDF6; border-radius:14rpx; }.link-result { margin-top:28rpx; padding:24rpx; background:#E0ECE5; border-radius:16rpx; }.share-url { display:block; margin-top:12rpx; color:#173C48; font-size:24rpx; word-break:break-all; }.expires { display:block; margin-top:12rpx; color:#617176; font-size:22rpx; }.copy { margin-top:18rpx; color:#173C48; background:#FFFDF6; border-radius:12rpx; font-size:26rpx; }