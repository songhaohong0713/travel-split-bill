.page { padding: 48rpx 40rpx; background: #F3F0E8; min-height: 100vh; }.title { display:block; font-size:56rpx; font-weight:700; color:#173C48; }.hint { display:block; margin:16rpx 0 36rpx; color:#617176; }.transfer { margin:18rpx 0; padding:28rpx; display:flex; justify-content:space-between; background:#FFFDF6; border-radius:16rpx; color:#173C48; }.empty { padding:48rpx 0; color:#617176; text-align:center; }.primary,.secondary { margin-top:24rpx; border-radius:16rpx; }.primary { background:#173C48; color:#FFFDF6; }.secondary { background:#D9E5DE; color:#173C48; }