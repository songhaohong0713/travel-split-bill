<view class="screen">
 <view wx:if="{{!loading || loadedView}}" class="heading"><view class="row"><text class="title">{{title}}</text><text wx:if="{{day || allSettled}}" class="badge {{allSettled ? 'settled' : day.status}}">{{allSettled ? '已结清' : statusLabel}}</text></view><text class="muted block">{{name || '旅行账本'}}<block wx:if="{{!loading}}"> · {{expenseCount}} 笔{{original ? ' · ' + original : ''}}</block></text></view>
 <view wx:if="{{loading}}" class="card loading-card">{{all ? '正在整理所选日期账单' : '正在整理当天账单'}}</view><view wx:if="{{error}}"><text class="error">{{error}}</text><button class="secondary" bindtap="reload">重试</button></view>
 <block wx:if="{{!loading && !error}}"><view wx:if="{{compatibilityError}}" class="card"><text class="block">结清服务需要更新</text><text class="muted block">{{compatibilityError}}</text></view>
  <view wx:if="{{memberCount > 1}}" class="card"><view class="row"><text class="section-title">{{transferTitle}}</text><text class="muted">共 {{transferCount}} 笔</text></view>
   <view wx:for="{{transfers}}" wx:key="viewKey" class="transfer-block"><view class="transfer-row {{item.settled ? 'paid' : ''}}"><view class="people"><text class="avatar {{item.fromIsCurrent ? 'self' : 'dark'}}">{{item.fromAvatar}}</text><text class="muted">→</text><text class="avatar {{item.toIsCurrent ? 'self' : 'dark'}}">{{item.toAvatar}}</text></view><view class="transfer-amount"><text class="block">{{item.amountText}}</text><text class="muted block">{{item.currency}}</text></view></view><text class="muted block transfer-direction">{{item.from}} 付给 {{item.to}}<text wx:if="{{item.combined}}"> · 合并转账的本日分配</text></text><view wx:if="{{item.settled}}" class="row"><text class="marked">✓ {{item.by}} · {{item.time}} 已确认结清</text><text class="revoke-link" data-id="{{item.id}}" bindtap="revoke">撤销</text></view><block wx:else><view class="row"><button wx:if="{{item.recipient}}" class="secondary small-button" data-index="{{index}}" bindtap="copyBill">复制账单</button><button wx:else class="secondary small-button" data-index="{{index}}" bindtap="copyAmount">复制金额</button><button class="secondary small-button remind" open-type="share">{{(item.recipient ? item.from : item.to)==='同行人' ? '分享账单提醒' : '微信提醒'+(item.recipient ? item.from : item.to)}}</button></view><text wx:if="{{item.marked}}" class="marked block footnote">{{item.markText}}</text></block></view>
   <text wx:if="{{!transferCount}}" class="muted block no-transfer">{{day.status === 'recording' ? '今天仍在记录中，明天再结算' : '当前无需转账'}}</text>
   <text wx:if="{{transferCount && !allSettled && day.status !== 'settled'}}" class="muted block footnote">付款方可标记付款；收到钱后由收款方确认，才算结清。</text>
   <text wx:if="{{scopeMessage}}" class="muted block">{{scopeMessage}}</text>
  </view>
  <text wx:if="{{timezoneNeedsSetup}}" class="muted block">请旅行创建者在旅行设置中补设结算时区，确保双方日期一致。</text>
  <view wx:if="{{carriedTo.length}}" class="card"><text class="section-title block">结清后的修改</text><text class="muted block">原转账记录保留，差额记入以下账单</text><view wx:for="{{carriedTo}}" wx:key="date" class="row carry-row" data-date="{{item.date}}" bindtap="openCarry"><text>{{item.title}}</text><text>{{item.amountText}} ›</text></view></view>
  <view wx:if="{{hasCarry}}" class="card"><text class="section-title block">补差额</text><view wx:for="{{carry}}" wx:key="source_date" class="row carry-row"><text class="muted">{{item.source_date}} 结清后补记</text><text>{{item.amount}} {{item.currency}}</text></view></view>
  <view wx:if="{{hasGroups}}" class="card"><text class="section-title block">分摊明细</text><view wx:for="{{groupRows}}" wx:key="currency"><view class="table-head table-row muted"><text>成员</text><text>实际支付（{{item.currency==='CNY' ? '元' : item.currency}}）</text><text>应承担（{{item.currency==='CNY' ? '元' : item.currency}}）</text></view><view wx:for="{{item.members}}" wx:for-item="member" wx:key="id" class="table-row"><text>{{member.name}}</text><text>{{member.paid}}</text><text class="responsibility">{{member.responsibility}}</text></view></view></view>
  <view class="card"><view class="row"><text class="section-title">{{all ? '所选日期消费' : '当天消费'}}</text><text class="muted">共 {{expenseCount}} 笔</text></view><view wx:for="{{expenses}}" wx:key="id" class="expense-row row" data-id="{{item.id}}" bindtap="openExpense"><view><text class="expense-name block">{{item.title}}</text><text class="muted block">{{item.itemCount}} 项 · {{item.payer}}付</text></view><view class="expense-money"><text class="block">{{item.originalText}}　›</text><text class="muted block">{{item.settlementText}}</text></view></view><text wx:if="{{!expenseCount}}" class="muted block no-transfer">没有消费记录</text></view>
 </block>
 <view wx:if="{{!loading && !error && (canSettle || (compatibilityError && hasTransfers))}}" class="bottom-bar"><button class="primary" loading="{{busy}}" disabled="{{busy || confirming || payerWaiting || !!compatibilityError}}" bindtap="confirmPayment">{{compatibilityError ? '服务更新后可结清' : paymentLabel}}</button></view>
</view>
