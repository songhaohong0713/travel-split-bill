@import "../../styles/round2.wxss";
.heading .title{font-size:48rpx;}.transfer-block{margin-top:28rpx;}.transfer-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;background:var(--bg-page);border-radius:28rpx;padding:28rpx 24rpx;}.transfer-row.paid{background:var(--brand-green-subtle);color:var(--brand-green);}.people{display:flex;align-items:center;gap:18rpx;}.avatar{background:var(--brand-green-subtle);color:var(--brand-green);max-width:120rpx;min-width:64rpx;padding:0 6rpx;height:72rpx;line-height:72rpx;text-align:center;border-radius:50%;font-size:24rpx;overflow:hidden;white-space:nowrap;}.avatar.dark{background:var(--text-primary);color:var(--bg-surface);}.transfer-amount{text-align:right;font-size:44rpx;font-weight:700;}.transfer-amount .muted{font-size:23rpx;font-weight:400;}.transfer-direction{margin:24rpx 0;}.small-button{flex:1;font-size:26rpx;min-height:84rpx;line-height:84rpx;padding:0 12rpx;border-radius:24rpx;}.marked{color:var(--brand-green);font-size:25rpx;}.footnote{font-size:23rpx;margin-top:24rpx;}.no-transfer{padding:24rpx 0 0;}.table-row{display:flex;align-items:center;justify-content:space-between;padding-top:20rpx;font-size:28rpx;}.table-row text{flex:1;text-align:right;}.table-row text:first-child{text-align:left;}.table-head{font-size:22rpx;margin-top:12rpx;}.responsibility{font-weight:700;}.expense-row{padding:24rpx 0;border-top:1rpx solid var(--bg-subtle);margin-top:20rpx;}.expense-row+.expense-row{margin-top:0;}.expense-name{font-size:32rpx;font-weight:600;}.expense-row .muted{font-size:23rpx;}.expense-money{text-align:right;font-size:30rpx;font-weight:600;}.carry-row{margin-top:20rpx;font-size:28rpx;}

.revoke-link{color:var(--status-danger);text-decoration:underline;font-size:26rpx}.remind{background:var(--brand-green-subtle);color:var(--brand-green)}
