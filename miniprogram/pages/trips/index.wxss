@import "../../styles/round2.wxss";
.greeting{font-size:52rpx;margin-top:16rpx}.summary-value{display:block;font-size:88rpx;font-weight:700;line-height:1.8;font-variant-numeric:tabular-nums}.summary-foot{border-top:1rpx solid var(--border-divider);margin-top:24rpx;padding-top:24rpx}.list-heading{margin:40rpx 0 28rpx}.trip-card{padding:32rpx 36rpx;min-height:96rpx;gap:24rpx}.trip-avatar{background:var(--brand-green-subtle);color:var(--brand-green);border-radius:28rpx;min-width:88rpx;height:88rpx;line-height:88rpx;text-align:center;font-size:34rpx;font-weight:700}.trip-avatar.invite{background:var(--status-pending-bg);color:var(--status-pending)}.trip-avatar.settled{background:var(--border-divider);color:var(--text-secondary)}.trip-copy{flex:1;min-width:0}.name-line{display:flex;align-items:center;gap:12rpx;margin-bottom:8rpx}.trip-name{font-size:34rpx;font-weight:700}.ongoing{background:var(--brand-green-subtle);color:var(--brand-green);font-size:20rpx;border-radius:20rpx;padding:2rpx 12rpx}.trip-copy .muted,.trip-status .muted{font-size:23rpx}.trip-status{text-align:right;font-size:30rpx;font-weight:600;color:var(--brand-green)}.trip-status.invite{color:var(--status-pending)}.trip-status.settled{color:var(--text-secondary)}.sort-button{margin:0;background:var(--bg-surface);border-radius:40rpx;font-size:25rpx;line-height:60rpx;padding:0 24rpx}.sort-button.selected{outline:3rpx solid var(--brand-green)}.sort-caption{margin:36rpx 0 8rpx}.skeleton{height:110rpx;background:var(--border-divider);opacity:.45}.login-notice{background:var(--status-pending-bg);border-radius:24rpx;padding:24rpx;margin-bottom:24rpx;font-size:26rpx}.retry{font-size:24rpx;margin:0;background:var(--bg-surface)}.bottom-bar .secondary{min-width:180rpx}

.trip-status.empty{color:var(--text-secondary)}.trip-status.payable{color:var(--status-pending)}.login-notice{background:var(--status-danger-bg);color:var(--status-danger)}
