<view class="screen">
  <view class="heading"><text class="muted block">{{greeting}}</text><text class="title greeting">下一笔，记到哪段旅程？</text></view>
  <view wx:if="{{authFailed}}" class="login-notice row"><view><text class="block">登录未完成</text><text class="muted block">未能识别登录状态，仍可新建旅行</text></view><button class="retry" bindtap="retryLogin">重试</button></view>
  <view wx:if="{{tripCount}}" class="card home-summary">
    <view class="row"><text class="muted">累计待结清</text><text wx:if="{{!hasSummary}}" class="chip">¥ CNY</text></view>
    <block wx:if="{{hasSummary}}"><view wx:for="{{summaryGroups}}" wx:key="currency" class="summary-currency"><view class="row"><text class="summary-value"><text class="money-symbol">{{item.symbol}}</text>{{item.amount}}</text><text class="chip">{{item.currency}}</text></view><text class="muted block">{{item.direction}}</text></view></block>
    <view wx:else><text class="summary-value"><text class="money-symbol">¥</text>0.00</text><text class="muted block">当前无需转账</text></view>
    <view class="summary-foot muted">{{tripCount}} 段旅行　 ·　 {{pendingTrips}} 段待结清</view>
  </view>
  <view class="row list-heading"><text class="section-title">继续记账</text><text class="muted">最近创建</text></view>
  <text wx:if="{{loading}}" class="muted block empty">正在加载…</text>
  <view wx:if="{{error}}" class="empty"><text class="error">{{error}}</text><button class="secondary" bindtap="loadTrips">重试</button></view>
  <view wx:if="{{!loading && !tripCount && !error}}" class="card"><text class="section-title block">还没有旅行账单</text><text class="muted block">先创建一段旅行，再记录每一笔共同消费。</text></view>
  <view wx:for="{{trips}}" wx:key="id" class="card trip-card row" data-id="{{item.id}}" bindtap="openTrip"><view class="trip-copy"><text class="trip-name block">{{item.name}}</text><text class="muted block">{{item.subtitle}}</text></view><view class="trip-status"><text class="{{item.hasPending ? 'danger' : 'muted'}}">{{item.statusText}}</text><text class="arrow">›</text></view></view>
  <view class="bottom-bar row"><button class="primary" bindtap="quickExpense">+ 记一笔</button><button class="secondary" bindtap="createTrip">新建旅行</button></view>
</view>
