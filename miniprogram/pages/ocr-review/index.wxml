<view class="page">
  <view class="masthead">
    <text class="eyebrow">小票识别</text>
    <text class="title">批量核对商品</text>
    <text class="subtitle">已识别 {{candidates.length}} 项。取消不需要的条目，修改后一次加入账单。</text>
  </view>

  <view wx:if="{{status === 'failed'}}" class="failure-card">
    <text class="card-title">这张小票没有识别成功</text>
    <text class="failure-copy">{{errorCode ? '错误代码：' + errorCode + '。' : ''}}你可以返回后重新拍摄清晰、完整的小票；也可以直接手动填写商品与金额。</text>
    <button class="secondary" bindtap="returnToManualEntry">返回手动录入</button>
  </view>

  <view wx:else>
    <view wx:if="{{candidates.length}}" class="review-list">
      <view wx:for="{{candidates}}" wx:key="id" class="review-item {{item.selected ? '' : 'excluded'}}">
        <view class="review-head"><checkbox checked="{{item.selected}}" color="#173C48" data-id="{{item.id}}" bindtap="toggleCandidate"/><text class="source-text">{{item.sourceText}}</text></view>
        <view class="edit-grid">
          <view class="edit-field name-field"><text class="label">中文名称</text><input value="{{item.translatedText}}" placeholder="填写中文名称" data-id="{{item.id}}" data-field="translatedText" bindinput="updateCandidate"/></view>
          <view class="edit-field amount-field"><text class="label">金额</text><input type="digit" value="{{item.amount}}" placeholder="0.00" data-id="{{item.id}}" data-field="amount" bindinput="updateCandidate"/></view>
          <view class="edit-field currency-field"><text class="label">币种</text><input value="{{item.currency}}" placeholder="JPY" maxlength="3" data-id="{{item.id}}" data-field="currency" bindinput="updateCandidate"/></view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-card">
      <text class="card-title">没有可用候选</text>
      <text class="hint">请直接手动填写，不会影响后续分账。</text>
    </view>

    <text wx:if="{{candidates.length}}" class="hint review-hint">税额、优惠和分担方式将在账单页统一设置。</text>
    <button wx:if="{{candidates.length}}" class="primary" bindtap="confirmSelected">确认所选商品</button>
  </view>
</view>
