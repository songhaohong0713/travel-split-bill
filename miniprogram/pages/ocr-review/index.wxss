.page { padding: 64rpx 40rpx 88rpx; }
.masthead { margin-bottom: 52rpx; }
.eyebrow { display: block; color: #C46642; font-size: 22rpx; letter-spacing: 3rpx; }
.title { display: block; margin-top: 18rpx; font-size: 56rpx; font-weight: 700; }
.subtitle { display: block; margin-top: 18rpx; color: #617176; font-size: 28rpx; line-height: 1.65; }
.card, .empty-card, .failure-card { margin-bottom: 28rpx; padding: 28rpx; border-radius: 18rpx; background: #FFFDF6; }
.label { display: block; margin-bottom: 18rpx; color: #617176; font-size: 25rpx; }
.candidate { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 24rpx 0; border-top: 1rpx solid #E2DED2; }
.candidate:first-of-type { border-top: 0; }
.candidate.selected { margin: 0 -12rpx; padding-right: 12rpx; padding-left: 12rpx; background: #D9E5DE; border-radius: 12rpx; }
.candidate-text { flex: 1; color: #173C48; font-size: 29rpx; }
.candidate-amount { color: #C46642; font-size: 28rpx; font-weight: 600; }
input { min-height: 84rpx; margin-bottom: 28rpx; padding: 0 20rpx; background: #F3F0E8; border-radius: 12rpx; color: #173C48; }
.hint, .failure-copy { display: block; color: #617176; font-size: 25rpx; line-height: 1.65; }
.card-title { display: block; margin-bottom: 14rpx; color: #173C48; font-size: 34rpx; font-weight: 600; }
.failure-card { border-left: 8rpx solid #C46642; }
.primary, .secondary { border-radius: 16rpx; font-weight: 600; }
.primary { background: #173C48; color: #FFFDF6; }
.secondary { margin-top: 28rpx; color: #173C48; background: #D9E5DE; }
.review-list { display:flex; flex-direction:column; gap:18rpx; margin-bottom:26rpx; }
.review-item { padding:24rpx; border:2rpx solid #ddd8cc; border-radius:18rpx; background:#fffdf6; }
.review-item.excluded { opacity:.48; }
.review-head { display:flex; align-items:flex-start; gap:14rpx; margin-bottom:18rpx; }
.source-text { flex:1; color:#617176; font-size:23rpx; line-height:1.5; }
.edit-grid { display:grid; grid-template-columns:minmax(0,1fr) 150rpx 112rpx; gap:12rpx; }
.edit-field .label { margin-bottom:8rpx; font-size:20rpx; }
.edit-field input { box-sizing:border-box; width:100%; min-height:72rpx; margin:0; padding:0 14rpx; }
.review-hint { margin:4rpx 4rpx 22rpx; }
