.trip-detail-page { min-height: 100vh; padding: 42rpx 28rpx 56rpx; box-sizing: border-box; background: #F6F4EC; color: #143E47; }
.trip-overview { margin-bottom: 16rpx; padding: 24rpx; color: #FFFDF8; background: #124954; border-radius: 22rpx; }.overview-label, .overview-note, .overview-warning { display: block; }.overview-label { color: #C9DFD8; font-size: 22rpx; }.overview-total { margin-top: 8rpx; font-size: 52rpx; font-weight: 700; font-variant-numeric: tabular-nums; }.overview-currency { margin-left: 10rpx; color: #C9DFD8; font-size: 22rpx; }.overview-note { margin-top: 12rpx; color: #D7E6DF; font-size: 23rpx; }.overview-warning { margin-top: 8rpx; color: #F6CFB8; font-size: 21rpx; }
.settlement-overview { margin-bottom: 16rpx; padding: 20rpx; background: #E8F0EB; border: 2rpx solid #CFE0D5; border-radius: 22rpx; }.settlement-group { position: relative; margin-top: 16rpx; padding: 18rpx; background: #FFFDF8; border-radius: 16rpx; }.settlement-currency { position: absolute; top: 16rpx; right: 18rpx; color: #D06A42; font-size: 21rpx; font-weight: 700; }.settlement-head, .settlement-person { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8rpx; }.settlement-head { padding-right: 72rpx; color: #718186; font-size: 20rpx; }.settlement-person { margin-top: 12rpx; color: #123E45; font-size: 23rpx; font-variant-numeric: tabular-nums; }.settlement-head text:not(:first-child), .settlement-person text:not(:first-child) { text-align: right; }.transfer-result, .settlement-warning { display: block; margin-top: 14rpx; }.transfer-result { padding-top: 14rpx; color: #123E45; border-top: 2rpx solid #E8E1D6; font-size: 23rpx; font-weight: 600; }.settlement-warning { color: #9A5539; font-size: 22rpx; }
.masthead { margin: 6rpx 6rpx 32rpx; }.kicker { display: block; color: #C86D45; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }.title { display: block; margin-top: 12rpx; font-size: 56rpx; font-weight: 700; }.subtitle { display: block; margin-top: 8rpx; color: #66767A; font-size: 26rpx; }
.expense-list, .state-card, .empty-state { padding: 20rpx; background: #FFFDF8; border: 2rpx solid #E2DBCF; border-radius: 22rpx; }.list-heading, .summary-top, .expense-actions { display: flex; justify-content: space-between; align-items: center; }.section-title { font-size: 30rpx; font-weight: 700; }.section-note, .expense-meta, .currency, .empty-copy, .expense-preview { color: #718186; font-size: 22rpx; }.expense-summary { padding: 22rpx 0; border-top: 2rpx solid #E8E1D6; }.expense-summary:first-of-type { margin-top: 14rpx; }.expense-title, .expense-meta, .expense-preview { display: block; }.expense-title { font-size: 29rpx; font-weight: 600; }.expense-meta { margin-top: 8rpx; }.expense-preview { margin-top: 10rpx; }.delete-link, .delete-trip-button { color: #C86D45; font-size: 22rpx; }.amount { text-align: right; color: #D06A42; font-size: 30rpx; font-weight: 700; }.currency { display: block; margin-top: 4rpx; font-weight: 400; }.empty-state { text-align: center; background: #E8F0EA; border-color: #D0DED4; }.empty-title { display: block; font-size: 32rpx; font-weight: 700; }.empty-copy { display: block; margin-top: 10rpx; }.error { color: #9A5539; background: #F7E5DD; }.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }.primary, .secondary, .share-button, .invite-button { flex: 1; margin: 0; border-radius: 16rpx; font-weight: 600; }.primary, .share-button { color: #FFFDF8; background: #124954; }.secondary, .invite-button { color: #143E47; background: #E8F0EA; border: 2rpx solid #9DB9AA; }.invite-button, .share-button, .delete-trip-button { width: 100%; margin-top: 14rpx; }.delete-trip-button { background: transparent; border: 0; }
