@import "../../styles/round2.wxss";
.trip-title{flex:1;min-width:0;word-break:break-all;}.invite{border:0;margin:0;line-height:1.5;}.menu{background:transparent;margin:0;padding:0 8rpx;font-size:36rpx;line-height:1.5;}.list-heading{margin:40rpx 0 28rpx;}.day-card{padding:32rpx;}.day-title{font-size:32rpx;font-weight:700;}.day-foot{margin-top:16rpx;align-items:flex-start;}.day-foot .muted{font-size:23rpx;flex:1;}.day-balance{font-size:26rpx;text-align:right;max-width:52%;}.invite-copy{margin:20rpx 0 36rpx;}.skip{background:transparent;color:var(--text-secondary);font-size:28rpx;margin:20rpx auto 0;}

.menu{background:var(--brand-green-subtle);color:var(--brand-green);border-radius:40rpx;font-size:26rpx;padding:16rpx 28rpx}.hero{background:var(--brand-green);color:var(--bg-surface)}.hero .muted{color:var(--brand-green-border)}.hero-value{display:block;font-size:72rpx;font-weight:700;margin:20rpx 0}.hero .secondary{background:var(--bg-surface);color:var(--brand-green);margin-top:28rpx}.list-heading>.muted{max-width:65%;text-align:right;font-size:23rpx}

.delete-trip{margin-top:48rpx;border-top:1rpx solid var(--border-divider);padding-top:24rpx}
