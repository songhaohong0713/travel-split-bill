.trip-detail-page { min-height: 100vh; padding: 42rpx 28rpx 56rpx; box-sizing: border-box; background: #F4EFE5; color: #123E45; }
.masthead { margin: 6rpx 6rpx 32rpx; }.kicker { display: block; color: #C86D45; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }.title { display: block; margin-top: 12rpx; font-size: 56rpx; font-weight: 700; }.subtitle { display: block; margin-top: 8rpx; color: #66767A; font-size: 26rpx; }
.expense-list, .state-card, .empty-state { padding: 20rpx; background: #FFFDF8; border: 2rpx solid #E2DBCF; border-radius: 22rpx; }.list-heading, .row-main { display: flex; justify-content: space-between; align-items: center; }.section-title { font-size: 30rpx; font-weight: 700; }.section-note, .expense-meta, .currency, .empty-copy { color: #66767A; font-size: 22rpx; }.expense-row { padding: 22rpx 0; border-top: 2rpx solid #E8E1D6; }.expense-row:first-of-type { margin-top: 14rpx; }.expense-title, .expense-meta { display: block; }.expense-title { font-size: 29rpx; font-weight: 600; }.expense-meta { margin-top: 8rpx; }.amount { text-align: right; color: #C86D45; font-size: 30rpx; font-weight: 700; }.currency { display: block; margin-top: 4rpx; font-weight: 400; }.empty-state { text-align: center; background: #E8F0EA; border-color: #D0DED4; }.empty-title { display: block; font-size: 32rpx; font-weight: 700; }.empty-copy { display: block; margin-top: 10rpx; }.error { color: #9A5539; background: #F7E5DD; }.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }.primary, .secondary, .share-button { flex: 1; margin: 0; border-radius: 16rpx; font-weight: 600; }.primary, .share-button { color: #FFFDF8; background: #123E45; }.secondary { color: #123E45; background: #E8F0EA; border: 2rpx solid #9DB9AA; }.share-button { margin-top: 14rpx; }
