<view class="page trip-detail-page">
  <view class="masthead"><text class="kicker">旅行账本</text><text class="title">{{name}}</text><text class="subtitle">{{startDate || '日期待补充'}}{{endDate ? ' — ' + endDate : ''}} · 成员 {{memberCount || 1}}/2</text></view>
  <view wx:if="{{loading}}" class="state-card"><text>正在整理消费记录…</text></view>
  <view wx:elif="{{loadError}}" class="state-card error"><text>{{loadError}}</text></view>
  <view wx:if="{{dailyLedger}}" class="daily-ledger">
    <view class="ledger-card ledger-hero"><text class="ledger-section">累计待结清</text><text class="trip-pending">{{summaryIncomplete ? '请先补全消费数据' : summaryText}}</text><text class="ledger-muted">不含记录中的日期 · 成员 {{memberCount}}/2</text><button class="ledger-secondary" bindtap="settleTrip">查看并结清当前旅行</button></view>
    <view class="list-heading"><text class="section-title">每日账单</text><text class="section-note">共 {{days.length}} 天</text></view>
    <view wx:for="{{days}}" wx:key="date" class="ledger-card" data-date="{{item.date}}" bindtap="openDay"><view class="summary-top"><text class="expense-title">{{item.date}}</text><text class="ledger-badge">{{item.statusLabel}}</text></view><text class="ledger-muted">{{item.count}} 笔 · {{item.pendingText}} ›</text></view>
  </view>
  <block wx:elif="{{expenses.length}}">
  <view class="settlement-overview">
    <view class="list-heading"><text class="section-title">待结清</text><text class="section-note">按已保存消费计算</text></view>
    <text wx:if="{{settlementWarning}}" class="settlement-warning">{{settlementWarning}}</text>
    <view wx:for="{{settlementGroups}}" wx:key="currency" class="settlement-group">
      <text class="settlement-currency">{{item.currency}}</text>
      <view class="settlement-head"><text>成员</text><text>实际支付</text><text>应承担</text></view>
      <view wx:for="{{item.participants}}" wx:for-item="participant" wx:key="name" class="settlement-person"><text>{{participant.name}}</text><text>¥{{participant.paid}}</text><text>¥{{participant.responsibility}}</text></view>
      <text class="transfer-result">{{item.transferText}}</text>
    </view>
  </view>
  <view class="trip-overview"><text class="overview-label">旅行总消费</text><view><text class="overview-total">¥{{overview.total}}</text><text class="overview-currency">{{overview.currency}}</text></view><text class="overview-note">已记录 {{overview.recordCount}} 笔消费</text><text wx:if="{{overview.mixedCurrency}}" class="overview-warning">其他币种仅在单笔账单中展示，未重复相加</text></view>
  <view class="expense-list">
    <view class="list-heading"><text class="section-title">消费记录</text><text class="section-note">共 {{expenses.length}} 笔</text></view>
    <view wx:for="{{expenses}}" wx:key="id" class="expense-summary" data-id="{{item.id}}" bindtap="openExpense">
      <view class="summary-top"><text class="expense-title">{{item.title}}</text><view><text class="amount-label">{{item.amountLabel}}</text><text class="amount">¥{{item.total}}</text><text class="currency">{{item.currency}}</text><text wx:if="{{item.originalTotal}}" class="original-amount">商品小计 ¥{{item.originalTotal}} {{item.originalCurrency}}</text></view></view>
      <text class="expense-meta">{{item.occurredAt}} · {{item.itemCount}} 项 · {{item.payer || "待填写付款人"}}</text>
      <view class="expense-actions"><text class="expense-preview">查看商品与分账 ›</text><text wx:if="{{isOwner || item.isCreator}}" class="delete-link" data-id="{{item.id}}" catchtap="deleteExpenseRecord">删除</text></view>
    </view>
  </view>
  </block>
  <view wx:else class="empty-state"><text class="empty-title">还没有消费记录</text><text class="empty-copy">先记下第一笔消费，再逐项分账。</text></view>
  <view class="actions"><button class="primary" bindtap="chooseReceiptAndCreate" loading="{{creating}}" disabled="{{creating}}">拍小票，记录消费</button><button class="secondary" bindtap="createExpenseRecord" loading="{{creating}}" disabled="{{creating}}">手动录入</button></view>
  <button wx:if="{{isOwner && memberCount !== 2}}" class="invite-button" bindtap="prepareInvite" loading="{{inviting}}" disabled="{{inviting}}">邀请同行人</button>
  <button wx:if="{{inviteReady}}" class="share-button" open-type="share">发送邀请</button>
  <view wx:if="{{isOwner}}" class="ledger-card trip-date-editor"><text class="ledger-section">出行日期（可选）</text><calendar-picker id="date-calendar" mode="range" start="{{startDate}}" end="{{endDate}}" bindselect="onTravelDates"/><button class="ledger-secondary" bindtap="saveTripDates" loading="{{savingDates}}" disabled="{{savingDates}}">保存日期</button><text class="ledger-error">{{dateError}}</text></view>
  <button wx:if="{{isOwner}}" class="delete-trip-button" bindtap="deleteTripRecord">删除这段旅行</button>
</view>
