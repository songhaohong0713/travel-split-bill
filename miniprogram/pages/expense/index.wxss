.expense-page { min-height: 100vh; padding: 38rpx 28rpx 48rpx; box-sizing: border-box; background: #F4EFE5; color: #123E45; }
.masthead { margin: 4rpx 6rpx 26rpx; }
.kicker { display: block; color: #C86D45; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.expense-title-input { display: block; margin-top: 14rpx; padding: 0; color: #123E45; font-size: 52rpx; line-height: 1.15; font-weight: 700; letter-spacing: -2rpx; }.expense-date { display: inline-block; margin-top: 12rpx; color: #66767A; font-size: 25rpx; }
.bill-summary, .receipt-section, .ticket-list, .adjustment-section { margin-bottom: 16rpx; padding: 20rpx; background: #FFFDF8; border: 2rpx solid #E2DBCF; border-radius: 24rpx; box-sizing: border-box; }
.summary-head, .list-heading, .ticket-topline, .adjustment-row { display: flex; align-items: center; justify-content: space-between; }
.section-title { display: block; font-size: 32rpx; font-weight: 700; }
.summary-note, .batch-note, .receipt-status, .small-note { color: #66767A; font-size: 23rpx; }
.people-grid { display: flex; gap: 14rpx; margin-top: 14rpx; }
.person-field { flex: 1; min-width: 0; }
.field-label { display: block; color: #66767A; font-size: 23rpx; }
.person-field input, .quiet-input { margin-top: 12rpx; padding: 16rpx 0; border-bottom: 2rpx solid #D9D2C6; font-size: 29rpx; }
.receipt-section { position: relative; overflow: hidden; background: #E8F0EA; border-color: #D0DED4; }
.receipt-copy { padding-right: 230rpx; }
.receipt-button { position: absolute; top: 24rpx; right: 24rpx; margin: 0; padding: 14rpx 18rpx; color: #123E45; background: #FFFDF8; border: 2rpx solid #123E45; border-radius: 16rpx; font-size: 24rpx; line-height: 1.4; }
.receipt { width: 100%; max-height: 500rpx; margin-top: 24rpx; border-radius: 16rpx; }
.ocr-card { margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid #C4D7CA; }
.candidate { display: block; margin-top: 10rpx; color: #40595D; font-size: 25rpx; }
.text-button { margin: 16rpx 0 0; padding: 0; color: #C86D45; background: transparent; font-size: 25rpx; text-align: left; }
.text-button::after, .add-ticket::after, .remove-button::after { border: 0; }
.ticket-list { padding-bottom: 18rpx; }
.ticket-card { padding: 18rpx 4rpx; border-top: 2rpx solid #E5DED4; }.ticket-card:first-of-type { margin-top: 12rpx; }.ticket-card.is-selected { background: #EDF5EF; }
.compact-item-row { display: flex; align-items: center; gap: 12rpx; }.compact-item-name { flex: 1; overflow: hidden; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.compact-item-amount { color: #C86D45; font-size: 30rpx; font-weight: 700; }.compact-item-meta { display: flex; justify-content: space-between; margin: 8rpx 0 0 62rpx; color: #66767A; font-size: 22rpx; }.item-editor { margin: 16rpx 0 0 62rpx; padding-top: 14rpx; border-top: 2rpx dashed #D9D2C6; }
.select-mark { display: flex; align-items: center; gap: 10rpx; color: #66767A; font-size: 23rpx; }
.remove-button { margin: 0; padding: 4rpx 8rpx; color: #8A6A5E; background: transparent; font-size: 22rpx; }
.item-name { display: block; margin-top: 12rpx; font-size: 29rpx; font-weight: 600; }
.amount-row { display: flex; align-items: baseline; margin-top: 8rpx; padding-bottom: 8rpx; border-bottom: 2rpx solid #E5DED4; }
.currency-mark { color: #C86D45; font-size: 29rpx; font-weight: 700; }
.amount-input { flex: 1; margin-left: 8rpx; color: #123E45; font-size: 34rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.currency-code { color: #66767A; font-size: 22rpx; }
.allocation-picker, .batch-picker, .inline-picker { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; color: #123E45; font-size: 25rpx; }
.chevron { margin-left: auto; color: #66767A; }
.ratio-row { display: flex; align-items: center; gap: 10rpx; margin-top: 10rpx; color: #66767A; font-size: 23rpx; }
.ratio-row input { width: 78rpx; padding: 10rpx 8rpx; background: #FFFDF8; border: 2rpx solid #D9D2C6; border-radius: 10rpx; text-align: center; }
.add-ticket { margin: 14rpx 0 0; color: #123E45; background: #FFFDF8; border: 2rpx dashed #78958A; border-radius: 16rpx; font-size: 27rpx; }
.batch-bar { margin-bottom: 16rpx; padding: 20rpx; background: #123E45; color: #FFFDF8; border-radius: 24rpx; }
.batch-bar .batch-note { display: block; margin-top: 8rpx; color: #BFD5CB; }
.batch-picker { padding: 20rpx 0; color: #FFFDF8; border-bottom: 2rpx solid #42656A; }
.batch-bar .ratio-row { color: #DCEBE3; }
.batch-apply { margin-top: 22rpx; color: #123E45; background: #DCEBE3; border-radius: 16rpx; font-weight: 600; }
.adjustment-row { margin-top: 22rpx; }
.inline-picker { margin: 0; color: #66767A; font-size: 23rpx; }
.quiet-input { display: block; width: 100%; box-sizing: border-box; font-size: 27rpx; }
.checkout-bar { display: flex; align-items: center; justify-content: space-between; margin: 36rpx -32rpx -72rpx; padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); background: #FFFDF8; border-top: 2rpx solid #D9D2C6; box-shadow: 0 -8rpx 24rpx rgba(18, 62, 69, 0.08); }
.checkout-label { display: block; color: #66767A; font-size: 22rpx; }
.checkout-total { display: block; margin-top: 4rpx; color: #C86D45; font-size: 42rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.checkout-button { min-width: 248rpx; margin: 0; color: #FFFDF8; background: #123E45; border-radius: 16rpx; font-weight: 600; }.invite-button { margin: 0; padding: 4rpx 12rpx; color: #123E45; background: #E8F0EA; border: 1rpx solid #9DB9AA; border-radius: 12rpx; font-size: 22rpx; }
.list-actions { display: flex; align-items: center; gap: 16rpx; }.batch-toggle { color: #124954; font-size: 23rpx; font-weight: 600; }.item-ledger { margin-top: 14rpx; overflow: hidden; background: #FFFDF8; border: 2rpx solid #E2DBCF; border-radius: 16rpx; }.ledger-row { border-bottom: 2rpx solid #E8E1D6; }.ledger-row:last-child { border-bottom: 0; }.compact-item-row { min-height: 76rpx; padding: 18rpx 16rpx; gap: 12rpx; }.compact-item-copy { flex: 1; min-width: 0; }.compact-item-name { display: block; }.compact-item-meta { display: block; margin: 6rpx 0 0; color: #718186; font-size: 22rpx; }.compact-item-total { min-width: 110rpx; text-align: right; }.compact-item-amount { display: block; color: #D06A42; }.compact-item-total .currency { display: block; margin-top: 4rpx; color: #718186; font-size: 20rpx; }.item-editor { margin: 0; padding: 18rpx 16rpx 20rpx; background: #E8F0EB; border-top: 2rpx solid #CFE0D5; }.add-ticket { margin-top: 14rpx; }.expense-subtotal { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding: 20rpx; color: #FFFDF8; background: #124954; border-radius: 16rpx; font-size: 24rpx; }.subtotal-value { font-size: 36rpx; font-weight: 700; font-variant-numeric: tabular-nums; }.subtotal-currency { margin-left: 10rpx; color: #C9DFD8; font-size: 20rpx; }
.batch-toolbar { margin-top: 14rpx; padding: 16rpx; color: #143E47; background: #E8F0EB; border: 2rpx solid #CFE0D5; border-radius: 14rpx; }.batch-toolbar-heading { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; font-weight: 700; }.batch-finish { color: #124954; font-size: 22rpx; }.batch-toolbar-picker { display: flex; justify-content: space-between; margin-top: 12rpx; padding: 14rpx 0; border-top: 2rpx solid #CFE0D5; border-bottom: 2rpx solid #CFE0D5; font-size: 24rpx; }.batch-toolbar .ratio-row { color: #365C5E; }.batch-apply { margin-top: 14rpx; color: #FFFDF8; background: #124954; border-radius: 12rpx; font-size: 25rpx; }
