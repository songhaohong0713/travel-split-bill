@import "../../styles/round2.wxss";
.expense-screen{padding-bottom:190rpx}.page-heading,.amount-line,.field-row,.share-row,.more-heading,.optional-heading,.input-row,.item-actions,.percent-row{display:flex;align-items:center;justify-content:space-between}.page-heading{margin:18rpx 0 32rpx}.amount-card{padding:34rpx}.merchant{font-size:29rpx;margin-bottom:32rpx}.amount-line{gap:20rpx;margin-bottom:16rpx}.currency{font-size:29rpx;font-weight:600}.amount-input{font-size:76rpx;font-weight:600;flex:1;min-width:0;height:100rpx}.field-card{padding:8rpx 28rpx}.field-row{min-height:96rpx;border-bottom:1rpx solid #ECE8E1;gap:12rpx}.field-row:last-child{border:0}.date-row{flex-wrap:wrap;padding:12rpx 0}.date-options{display:flex;gap:10rpx;margin-left:auto}.date-options button{padding:6rpx 14rpx;font-size:24rpx;line-height:1.5;margin:0}.split-card{padding:28rpx}.section-label{font-weight:600}.split-tabs{display:flex;background:#F6F4F0;padding:6rpx;border-radius:18rpx;margin:24rpx 0}.split-tabs button{width:50%;margin:0;background:transparent;font-size:28rpx;line-height:2.5}.split-tabs .active{background:#E8EFEB;color:#2F5D4E;font-weight:600}.share-row{padding:18rpx 0;font-size:29rpx}.more-heading{padding:14rpx 6rpx 28rpx;color:#8B8B85;font-size:27rpx}.more-card{padding:4rpx 28rpx}.optional-heading{padding:28rpx 0;border-bottom:1rpx solid #ECE8E1;font-size:28rpx}.optional-body{padding:24rpx 0}.input-row{gap:20rpx;margin:22rpx 0}.input-row input{flex:1;min-width:0;background:#F6F4F0;border-radius:12rpx;padding:20rpx;font-size:27rpx}.item-editor{padding:12rpx 0 24rpx;border-bottom:1rpx solid #ECE8E1}.text-button{margin:0;padding:0 12rpx;background:transparent;color:#2F5D4E;font-size:25rpx;line-height:2}.text-button::after,.split-tabs button::after{border:0}.danger,.delete-button{color:#B5523B}.percent-row{justify-content:flex-start;gap:18rpx;margin:20rpx 0}.percent-row input{width:100rpx;background:#F6F4F0;padding:16rpx;border-radius:10rpx}.pending-note{margin-top:20rpx;font-size:24rpx;color:#8B8B85}.small{font-size:23rpx}.ocr-note{display:block;margin-top:18rpx;color:#2F5D4E;font-size:24rpx}.delete-button{background:transparent;font-size:27rpx;margin-top:24rpx}.badge{font-size:20rpx;margin-left:10rpx}.bottom-bar .primary{width:100%}
.field-card .split-card{padding:28rpx 0}.date-selected{background:#1A1A17!important;color:#fff!important}.calendar-option{border-radius:12rpx;padding:8rpx}.receipt-tag{display:inline-block;padding:10rpx 18rpx;background:#E8EFEB;color:#2F5D4E;border-radius:10rpx;margin-bottom:16rpx;font-size:24rpx}.save-note{display:block;text-align:center;color:#8B8B85;font-size:23rpx;margin-bottom:16rpx}.adjustment-sign{display:flex;gap:8rpx}.adjustment-sign button{font-size:22rpx;padding:4rpx 10rpx;line-height:2;margin:0}.adjustment-sign .active{background:#E8EFEB;color:#2F5D4E}.bottom-bar{display:block}

.amount-card{text-align:center;padding:40rpx 34rpx}.merchant{text-align:center;margin-bottom:24rpx}.amount-line{justify-content:center;gap:8rpx;margin:0 auto 20rpx;max-width:480rpx}.amount-symbol{color:#8B8B85;font-size:40rpx}.amount-input{font-size:92rpx;text-align:center;flex:0 1 370rpx}.currency.chip{font-size:25rpx;background:#F6F4F0;color:#1A1A17}.field-card .split-card{padding:24rpx 0 30rpx}.split-tabs{width:260rpx;margin:0}.split-tabs button{font-size:26rpx;line-height:2.2}.split-tabs .active{background:#FFFFFF;color:#1A1A17}.share-preview{display:flex;justify-content:space-between;gap:16rpx;background:#E8EFEB;color:#2F5D4E;border-radius:24rpx;padding:24rpx;margin-top:22rpx;font-size:26rpx;font-weight:600}.more-heading.card{padding:28rpx 36rpx;color:#1A1A17}.expense-screen{padding-bottom:calc(230rpx + env(safe-area-inset-bottom))}.screen{padding-top:28rpx}
