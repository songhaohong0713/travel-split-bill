<view class="screen expense-screen">
 <view wx:if="{{loading}}" class="loading-card card">{{expenseId ? '正在加载消费…' : '正在准备记账…'}}</view>
 <view wx:elif="{{loadFailed}}" class="card"><text class="error">{{error}}</text><button class="secondary" bindtap="retryLoad">重试</button></view><block wx:else><text wx:if="{{defaultTripHint}}" class="muted block">{{defaultTripHint}}</text>
 <view class="recognize-row">
  <text wx:if="{{receiptRecognized}}" class="receipt-tag">✓ 已识别小票，请核对</text>
  <button wx:if="{{receiptPath || receiptStatus === 'available'}}" class="text-button" loading="{{receiptLoading || previewLoading}}" disabled="{{receiptLoading || uploadingReceipt || previewLoading}}" bindtap="previewReceipt">查看小票原图</button>
  <text wx:elif="{{receiptLoading}}" class="muted small">正在读取小票…</text>
  <button wx:elif="{{receiptStatus === 'unavailable'}}" class="text-button" bindtap="loadReceipt">重试读取原图</button>
  <button wx:if="{{!receiptLoading && receiptStatus !== 'unavailable' && (expenseId || !receiptPath)}}" class="text-button" loading="{{uploadingReceipt}}" disabled="{{uploadingReceipt || saving}}" bindtap="chooseReceipt">{{expenseId ? (receiptStatus === 'available' ? '更换小票' : '补传小票') : '拍照 / 选小票'}}</button>
 </view>
 <text wx:if="{{receiptStatus === 'missing'}}" class="muted small block">历史小票未保留原图，可重新上传。</text>
 <text wx:if="{{expenseId && receiptAttachmentPending}}" class="muted small block">小票已上传，保存后关联到这笔消费；金额和分摊保持不变。</text>
 <text wx:if="{{previewLoading}}" class="muted small block">{{previewProgress ? "正在下载原图 " + previewProgress + "%" : "正在准备原图…"}}</text>
 <text wx:if="{{receiptError}}" class="date-warning small block">{{receiptError}}</text>
 <button wx:if="{{receiptError && receiptPath && !receiptJobId && !expenseId && !reading}}" class="text-button" loading="{{uploadingReceipt}}" disabled="{{uploadingReceipt}}" bindtap="retryReceiptUpload">重新上传并识别</button>
 <view wx:if="{{reading}}" class="card ocr-progress"><text class="block">{{ocrStage}}</text><text class="muted block">已用时 {{ocrElapsed}} 秒 · 完成后会自动填入</text><button class="text-button" bindtap="continueManual">继续手动填写</button></view><view class="amount-card card">
  <input class="merchant" placeholder="商户 / 消费名称（可选）" value="{{title}}" data-field="title" bindinput="onField" />
  <view class="amount-line"><input class="amount-input" type="digit" placeholder="金额" placeholder-style="font-size:48rpx;color:#8F8C84" value="{{amount}}" data-field="amount" bindinput="onField" /><picker range="{{currencies}}" value="{{currencyIndex}}" bindchange="onCurrency"><text class="currency chip">{{currency}} ⌄</text></picker></view>
  <text wx:if="{{convertedText}}" class="conversion-note">{{convertedText}} · {{actualPaymentAmount ? '按实际扣款折算' : showMore ? '汇率见下方' : '汇率 1 ' + currency + ' = ' + (referenceRateLabel || '—') + ' ' + settlementCurrency}}</text>
  <text wx:if="{{ocrStatus && !receiptRecognized && !reading}}" class="ocr-note">{{ocrStatus}}</text>
 </view>
 <view class="card field-card">
  <view class="field-row"><text class="muted">旅行</text><picker disabled="{{!!expenseId}}" range="{{tripNames}}" value="{{tripIndex}}" bindchange="onTrip"><text>{{tripName}} <text wx:if="{{tripOngoing}}" class="badge">进行中</text> ⌄</text></picker></view>
  <text wx:if="{{currencyDefaultHint && !expenseId}}" class="muted small block">{{currencyDefaultHint}}</text><view class="date-section"><view class="row"><text class="muted">日期</text><text wx:if="{{receiptDate}}" class="date-receipt {{!dateFromReceipt ? 'date-warning' : ''}}">{{dateFromReceipt ? '与小票日期一致' : '已修改，与小票日期不同'}}</text></view><view class="date-options"><button class="chip {{dateChoice === 'today' ? 'date-selected' : ''}}" data-offset="0" bindtap="quickDate">今天 {{today}}</button><button class="chip {{dateChoice === 'yesterday' ? 'date-selected' : ''}}" data-offset="1" bindtap="quickDate">昨天</button><view class="calendar-option {{dateChoice === 'calendar' ? 'date-selected' : ''}}"><calendar-sheet id="expense-date-picker" active="{{dateChoice === 'calendar'}}" label="{{dateChoice === 'calendar' ? occurredAt : '选日期'}}" value="{{occurredAt}}" bindselect="onDate" /></view></view><text wx:if="{{dateWarning}}" class="date-warning small block">{{dateWarning}}</text></view>
  <view class="field-row"><text class="muted">付款人</text><picker range="{{memberLabels}}" value="{{payerIndex}}" bindchange="onPayer"><text>{{memberLabels[payerIndex] || '等待成员'}} ⌄</text></picker></view>
  <view class="split-section"><view class="row"><text class="muted">分摊</text><view class="split-tabs"><button class="{{splitMode === 'even' ? 'active' : ''}}" data-mode="even" bindtap="onSplit">平分</button><button class="{{splitMode === 'items' ? 'active' : ''}}" data-mode="items" bindtap="onSplit">按商品</button><button class="{{splitMode === 'custom' ? 'active' : ''}}" data-mode="custom" bindtap="onSplit">自定义</button></view></view>
  <view wx:if="{{splitMode === 'custom'}}" class="custom-inputs"><view wx:for="{{customRows}}" wx:key="id" class="input-row"><text>{{item.label}}</text><input type="digit" value="{{item.value}}" placeholder="承担金额" data-id="{{item.id}}" bindinput="onCustomAmount" /><text>{{currency}}</text></view><text class="small muted">每人的金额合计须等于顶部消费金额</text></view>
  <view wx:if="{{splitMode !== 'items'}}" class="share-preview"><view wx:for="{{responsibilityRows}}" wx:key="id" class="share-row"><text class="avatar {{item.label === '我' ? 'avatar-self' : ''}}">{{item.avatar}}</text><text class="share-name">{{item.label}}{{item.isPayer ? '（付款人）' : ''}}</text><view class="share-amount"><text>{{item.originalText}}</text><text wx:if="{{item.convertedText}}" class="muted small block">{{item.convertedText}}</text></view></view><text class="share-note">{{shareNote}}</text></view>
  <text wx:if="{{expenseId && !splitChanged}}" class="muted small block history-note">已保留原有商品分摊、税费和优惠</text>
  </view>
 </view>
 <text wx:if="{{expenseId && memberCount > 1}}" class="muted small block history-note">若原日期已结清，修改产生的差额计入后续未结清日，原结清记录保留。</text><view wx:if="{{multiBillWarning}}" class="notice">{{multiBillWarning}}</view>
 <view class="more-heading card" bindtap="toggle"><view><text class="block">{{showMore ? '收起更多选项' : '更多选项'}}</text><text class="muted small">商品明细（{{items.length}} 项）· 汇率与实际扣款 · 账单调整</text></view><text>{{showMore ? '⌃' : '⌄'}}</text></view>
 <block wx:if="{{showMore}}">
 <view class="card detail-card"><view class="section-heading"><text>商品明细</text><text class="muted small">{{items.length}} 项</text></view><text class="muted small">点标签切换「平分 / 我的 / 同行人的」</text><view wx:for="{{items}}" wx:key="id" class="item-editor"><view class="item-main"><view class="item-description"><input placeholder="商品名称" value="{{item.name}}" data-id="{{item.id}}" data-field="name" bindinput="onItem" /><button class="owner-tag {{item.owner === currentMemberId ? 'owner-self' : item.owner && item.owner !== 'equal' ? 'owner-friend' : ''}}" data-id="{{item.id}}" bindtap="itemCustom">{{item.ownerLabel}}</button></view><input class="item-amount" type="digit" placeholder="金额" value="{{item.amount}}" data-id="{{item.id}}" data-field="amount" bindinput="onItem" /><text class="muted small item-currency">{{currency}}</text></view><view class="row"><text wx:if="{{item.raw.tax_amount}}" class="muted small">原税额 {{item.taxDisplay || item.raw.tax_amount.amount}}（{{item.raw.tax_included ? '已含' : '另计'}}）</text><button class="text-button danger small" data-id="{{item.id}}" bindtap="removeItem">移除</button></view></view><text wx:if="{{itemDifferenceText}}" class="error block">{{itemDifferenceText}}</text><view class="row item-footer"><button class="text-button" bindtap="addItem">＋ 添加商品</button><text>总额 {{amount || '0'}} {{currency}}</text></view></view>
 <view wx:if="{{splitMode === 'items'}}" class="card detail-card"><view class="section-heading"><text>本笔分摊</text><text class="muted small">按商品计算</text></view><view class="share-preview"><view wx:for="{{responsibilityRows}}" wx:key="id" class="share-row"><text class="avatar {{item.label === '我' ? 'avatar-self' : ''}}">{{item.avatar}}</text><text class="share-name">{{item.label}}{{item.isPayer ? '（付款人）' : ''}}</text><view class="share-amount"><text>{{item.originalText}}</text><text wx:if="{{item.convertedText}}" class="muted small block">{{item.convertedText}}</text></view></view><text class="share-note">{{shareNote}}</text></view></view>
 <view class="card detail-card"><view class="section-heading"><text>汇率与实际扣款</text></view><view class="rate-row"><text>汇率</text><text>1 {{currency}} = </text><input wx:if="{{!actualPaymentAmount}}" type="digit" value="{{referenceRate}}" data-field="referenceRate" bindinput="onField" /><text wx:else>{{effectiveRate}}</text><text>{{actualPaymentAmount ? actualPaymentCurrency : settlementCurrency}}</text></view><text class="muted small">{{actualPaymentAmount ? '由实际扣款倒推的有效汇率' : rateStatus + ' · 点数字可修改'}}</text><button wx:if="{{rateError && !actualPaymentAmount}}" class="text-button" loading="{{rateLoading}}" disabled="{{rateLoading}}" bindtap="refreshRate">重试获取汇率</button><button wx:if="{{rateError && savedRateLabel && !actualPaymentAmount}}" class="text-button" bindtap="useSavedRate">{{savedRateLabel}}</button><view class="actual-block"><text class="muted small">实际扣款（可选）</text><view class="input-row"><input type="digit" placeholder="账单上的实际扣款金额" value="{{actualPaymentAmount}}" data-field="actualPaymentAmount" bindinput="onField" /><picker range="{{currencies}}" value="{{actualCurrencyIndex}}" bindchange="onActualCurrency"><text>{{actualPaymentCurrency}} ⌄</text></picker></view><text class="muted small">填写后按实际扣款折算，手续费按份额分担</text><text wx:if="{{actualPaymentUnchanged}}" class="muted small block">总额已变，实际扣款未改，请核对</text></view></view>
 <view class="card detail-card"><view class="row"><view><text class="block">账单调整</text><text class="muted small">折扣、免税、优惠券、小费</text></view><button class="text-button" bindtap="addAdjustment">＋ 添加</button></view><view wx:for="{{adjustments}}" wx:key="id" class="input-row"><view class="adjustment-sign"><button class="chip {{item.direction === 'add' ? 'active' : ''}}" data-id="{{item.id}}" data-direction="add" bindtap="adjustmentDirection">加收</button><button class="chip {{item.direction !== 'add' ? 'active' : ''}}" data-id="{{item.id}}" data-direction="discount" bindtap="adjustmentDirection">优惠</button></view><input type="digit" placeholder="金额" value="{{item.amount < 0 ? -item.amount : item.amount}}" data-id="{{item.id}}" bindinput="onAdjustment" /><button class="text-button danger" data-id="{{item.id}}" bindtap="removeAdjustment">移除</button></view></view>
 </block>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <button wx:if="{{expenseId && canDelete}}" class="delete-button" loading="{{deleting}}" disabled="{{deleting || saving}}" bindtap="deleteExpense">删除消费</button>
 <view class="bottom-bar"><text wx:if="{{uploadingReceipt}}" class="save-note">正在保存小票图片，请稍候…</text><text wx:else class="save-note">保存后记入「{{tripName}} · {{occurredAt}}」账单</text><view class="save-actions"><button wx:if="{{!expenseId}}" class="secondary" data-continue="1" disabled="{{saving || uploadingReceipt || reading || dateDecisionPending}}" bindtap="save">保存并继续</button><button class="primary" loading="{{saving}}" disabled="{{saving || uploadingReceipt || reading || dateDecisionPending}}" bindtap="save">{{expenseId ? '保存修改' : '保存'}}</button></view></view>
 </block>
</view>
