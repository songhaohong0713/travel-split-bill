<view class="page"><text class="title">手动录入</text><text class="hint">拍照识别后，也在这里逐项核对和分配。</text><text class="ocr-status">识别状态：{{ocrStatus}}</text><view wx:if="{{ocrCandidates.length}}" class="ocr-card"><text class="label">OCR 原文候选（请逐项核对）</text><text wx:for="{{ocrCandidates}}" wx:key="*this" class="candidate">{{item}}</text></view><button class="camera" bindtap="chooseReceipt">拍小票或从相册选择</button><image wx:if="{{receiptPath}}" class="receipt" src="{{receiptPath}}" mode="widthFix"/><view class="card"><text class="label">商品金额（{{currency}}）</text><input type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmount"/><text class="label">付款人</text><input placeholder="例如：我" value="{{payer}}" bindinput="onPayer"/><text class="label">同行人（可留空）</text><input placeholder="例如：小林" value="{{friend}}" bindinput="onFriend"/><text class="label">这件商品怎么分？</text><picker range="{{allocationLabels}}" bindchange="onAllocation"><text>{{allocationLabels[allocationIndex]}}</text></picker></view><button class="primary" bindtap="preview">查看分账预览</button></view>