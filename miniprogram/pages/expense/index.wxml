<view class="screen expense-screen">
 <view wx:if="{{reading || expenseId}}" class="page-heading"><text class="title">{{reading ? '消费详情' : expenseId ? '编辑消费' : '记一笔'}}</text><button wx:if="{{reading}}" class="text-button" bindtap="beginEditing">编辑</button></view>
 <text wx:if="{{receiptRecognized}}" class="receipt-tag">已识别小票，请确认</text>
 <view class="amount-card card">
  <input class="merchant" placeholder="商户 / 消费名称（可选）" value="{{title}}" disabled="{{reading}}" data-field="title" bindinput="onField" />
  <view class="amount-line"><text class="amount-symbol">{{amountSymbol}}</text><input class="amount-input" type="digit" placeholder="0.00" value="{{amount}}" disabled="{{reading}}" data-field="amount" bindinput="onField" /></view>
  <picker disabled="{{reading}}" range="{{currencies}}" value="{{currencyIndex}}" bindchange="onCurrency"><text class="currency chip">{{currency}} ⌄</text></picker>
  <text wx:if="{{ocrStatus && !receiptRecognized}}" class="ocr-note">{{ocrStatus}}</text>
 </view>
 <view class="card field-card">
  <view class="field-row"><text class="muted">旅行</text><picker disabled="{{reading || expenseId}}" range="{{tripNames}}" value="{{tripIndex}}" bindchange="onTrip"><text>{{tripName}} <text wx:if="{{tripOngoing}}" class="badge">进行中</text> ⌄</text></picker></view>
  <view class="field-row date-row"><text class="muted">日期</text><view wx:if="{{!reading}}" class="date-options"><button class="chip {{dateChoice === 'today' ? 'date-selected' : ''}}" data-offset="0" bindtap="quickDate">今天</button><button class="chip {{dateChoice === 'yesterday' ? 'date-selected' : ''}}" data-offset="1" bindtap="quickDate">昨天</button></view><view wx:if="{{!reading}}" class="calendar-option {{dateChoice === 'calendar' ? 'date-selected' : ''}}"><calendar-sheet wx:if="{{!reading}}" value="{{occurredAt}}" bindselect="onDate" /></view><text wx:if="{{reading}}">{{occurredAt}}</text><text wx:if="{{dateFromReceipt}}" class="badge">来自小票</text></view>
  <view class="field-row"><text class="muted">付款人</text><picker wx:if="{{!reading}}" range="{{memberLabels}}" value="{{payerIndex}}" bindchange="onPayer"><text>{{memberLabels[payerIndex] || '等待成员'}} ⌄</text></picker><text wx:else>{{memberLabels[payerIndex]}}</text></view>
 <view class="split-card"><view class="row"><text class="muted">分摊</text>
  <view wx:if="{{!reading}}" class="split-tabs"><button class="{{splitMode === 'even' ? 'active' : ''}}" data-mode="even" bindtap="onSplit">平分</button><button class="{{splitMode === 'custom' ? 'active' : ''}}" data-mode="custom" bindtap="onSplit">自定义</button></view></view>
  <view wx:if="{{!reading && splitMode === 'custom'}}" class="percent-row"><text>我承担</text><input type="digit" value="{{selfPercent}}" bindinput="onPercent" /><text>%</text></view>
  <view class="share-preview"><text wx:for="{{responsibilityRows}}" wx:key="id">{{item.label}} {{amountSymbol}}{{item.amount}}</text></view>
  <view wx:if="{{memberCount === 1}}" class="pending-note"><text>同行人未加入，双人分摊需邀请后保存</text><button wx:if="{{!reading}}" class="text-button" bindtap="selfOnly">自己承担 100%</button></view>
  <text wx:if="{{expenseId && !splitChanged}}" class="muted small">已保留原有商品分摊、税费和优惠</text>
 </view>
 </view>
 <view class="more-heading card" data-field="showMore" bindtap="toggle"><view><text class="block">更多选项</text><text class="muted small">币种换算 · 商品明细 · 账单调整</text></view><text>{{showMore ? '⌃' : '⌄'}}</text></view>
 <view wx:if="{{showMore}}" class="card more-card">
  <view class="optional-heading" data-field="showConversion" bindtap="toggle"><text>币种换算</text><text>{{showConversion ? '−' : '+'}}</text></view>
  <view wx:if="{{showConversion}}" class="optional-body"><text class="muted small">实际支付可选；填写后用于结算</text><view class="input-row"><picker disabled="{{reading}}" range="{{currencies}}" value="{{actualCurrencyIndex}}" bindchange="onActualCurrency">{{actualPaymentCurrency}} ⌄</picker><input disabled="{{reading}}" type="digit" placeholder="实际支付金额（可选）" value="{{actualPaymentAmount}}" data-field="actualPaymentAmount" bindinput="onField" /></view><text class="muted small">{{rateStatus}} · {{referenceRate || '—'}} {{currency}} → {{settlementCurrency}}</text></view>
  <view class="optional-heading" data-field="showItems" bindtap="toggle"><text>商品明细 <text class="muted">（可选）</text></text><text>{{showItems ? '−' : '+'}}</text></view>
  <view wx:if="{{showItems}}" class="optional-body"><text class="muted small">明细金额合计须等于顶部消费金额；税费和优惠另列</text>
   <view wx:for="{{items}}" wx:key="id" class="item-editor"><view class="input-row"><input disabled="{{reading}}" placeholder="商品名称" value="{{item.name}}" data-id="{{item.id}}" data-field="name" bindinput="onItem" /><input disabled="{{reading}}" type="digit" placeholder="商品金额" value="{{item.amount}}" data-id="{{item.id}}" data-field="amount" bindinput="onItem" /></view><text wx:if="{{item.raw.tax_amount}}" class="muted small">原税额 {{item.raw.tax_amount.amount}}（{{item.raw.tax_included ? '已含' : '另计'}}）</text><view wx:if="{{!reading}}" class="item-actions"><button class="text-button" data-id="{{item.id}}" bindtap="itemCustom">{{item.custom ? '使用整单分摊' : '自定义此项比例'}}</button><button class="text-button danger" data-id="{{item.id}}" bindtap="removeItem">移除</button></view><view wx:if="{{item.custom}}" class="percent-row"><text>我承担</text><input disabled="{{reading}}" type="digit" value="{{item.selfPercent}}" data-id="{{item.id}}" data-field="selfPercent" bindinput="onItem" /><text>%</text></view></view>
   <button wx:if="{{!reading}}" class="secondary" bindtap="addItem">＋ 添加商品</button>
  </view>
  <view class="optional-heading" data-field="showAdjustments" bindtap="toggle"><text>账单调整 <text class="muted">（可选）</text></text><text>{{showAdjustments ? '−' : '+'}}</text></view>
  <view wx:if="{{showAdjustments}}" class="optional-body"><text class="muted small">选择加收或优惠；原调整规则保留</text><view wx:for="{{adjustments}}" wx:key="id" class="input-row"><view wx:if="{{!reading}}" class="adjustment-sign"><button class="chip {{item.direction === 'add' ? 'active' : ''}}" data-id="{{item.id}}" data-direction="add" bindtap="adjustmentDirection">加收</button><button class="chip {{item.direction !== 'add' ? 'active' : ''}}" data-id="{{item.id}}" data-direction="discount" bindtap="adjustmentDirection">优惠</button></view><input disabled="{{reading}}" type="digit" placeholder="调整金额" value="{{item.amount < 0 ? -item.amount : item.amount}}" data-id="{{item.id}}" bindinput="onAdjustment" /><button wx:if="{{!reading}}" class="text-button danger" data-id="{{item.id}}" bindtap="removeAdjustment">移除</button></view><button wx:if="{{!reading}}" class="secondary" bindtap="addAdjustment">＋ 添加调整</button></view>
 </view>
 <view wx:if="{{error}}" class="error">{{error}}</view>
 <button wx:if="{{reading && canDelete}}" class="delete-button" bindtap="deleteExpense">删除消费</button>
 <view wx:if="{{!reading}}" class="bottom-bar"><text class="save-note">保存后记入「{{tripName}} · {{occurredAt}}」账单</text><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存</button></view>
</view>
