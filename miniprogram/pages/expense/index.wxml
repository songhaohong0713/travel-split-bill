<view class="page">
  <text class="title">录入账单</text>
  <text class="hint">添加多件商品，再批量选择商品进行分账。</text>
  <text class="ocr-status">识别状态：{{ocrStatus}}</text>
  <view wx:if="{{ocrCandidates.length}}" class="ocr-card"><text class="label">OCR 原文候选（请逐项核对）</text><text wx:for="{{ocrCandidates}}" wx:key="*this" class="candidate">{{item.text || item}}</text><button class="secondary" bindtap="openOcrReview">核对 OCR 候选</button></view>
  <button class="camera" bindtap="chooseReceipt">拍小票或从相册选择</button>
  <image wx:if="{{receiptPath}}" class="receipt" src="{{receiptPath}}" mode="widthFix"/>
  <view class="card">
    <text class="label">付款人</text><input placeholder="例如：我" value="{{payer}}" bindinput="onPayer"/>
    <text class="label">同行人</text><input placeholder="例如：小林" value="{{friend}}" bindinput="onFriend"/>
  </view>
  <view class="card">
    <text class="section-title">商品条目</text>
    <view wx:for="{{items}}" wx:key="id" class="item-card">
      <view class="item-head"><switch checked="{{item.selected}}" data-id="{{item.id}}" bindchange="toggleItem" color="#173C48"/><text>批量选择</text><button size="mini" data-id="{{item.id}}" bindtap="removeItem">删除</button></view>
      <input placeholder="商品名称，例如：晚餐" value="{{item.name}}" data-id="{{item.id}}" bindinput="onItemName"/>
      <input type="digit" placeholder="金额（{{currency}}）" value="{{item.amount}}" data-id="{{item.id}}" bindinput="onItemAmount"/>
      <picker range="{{batchModes}}" value="{{item.allocationMode === 'payer' ? 0 : item.allocationMode === 'friend' ? 1 : item.allocationMode === 'split' ? 2 : 3}}" data-id="{{item.id}}" bindchange="onItemMode"><view class="picker">分账方式：{{item.allocationMode === 'payer' ? '付款人自己买' : item.allocationMode === 'friend' ? '同行人自己买' : item.allocationMode === 'split' ? '两人均分' : '自定义比例'}}</view></picker>
      <view wx:if="{{item.allocationMode === 'custom'}}" class="ratio-row"><input type="digit" value="{{item.payerPercent}}" data-id="{{item.id}}" bindinput="onItemPayerPercent"/><text>% 付款人</text><input type="digit" value="{{item.friendPercent}}" data-id="{{item.id}}" bindinput="onItemFriendPercent"/><text>% 同行人</text></view>
    </view>
    <button class="secondary" bindtap="addItem">+ 添加商品</button>
  </view>
  <view class="card">
    <text class="section-title">批量分账</text><text class="hint">先打开商品条目左侧开关，再应用规则。</text>
    <picker range="{{batchModes}}" value="{{batchModeIndex}}" bindchange="onBatchMode"><view class="picker">{{batchModes[batchModeIndex]}}</view></picker>
    <view wx:if="{{batchModeIndex === 3}}" class="ratio-row"><input type="digit" value="{{batchPayerPercent}}" bindinput="onBatchPayerPercent"/><text>% 付款人</text><input type="digit" value="{{batchFriendPercent}}" bindinput="onBatchFriendPercent"/><text>% 同行人</text></view>
    <button class="secondary" bindtap="applyBatchAllocation">应用到已选择商品</button>
  </view>
  <view class="card">
    <text class="label">税额（可选）</text><switch checked="{{taxIncluded}}" bindchange="onTaxIncluded" color="#173C48"/><text class="hint">商品金额{{taxIncluded ? "已含税" : "未含税，税额将另计"}}</text><input type="digit" placeholder="例如 10" value="{{taxAmount}}" bindinput="onTax"/>
    <text class="label">优惠 / 退款（负数，可选）</text><input type="digit" placeholder="例如 -20" value="{{adjustmentAmount}}" bindinput="onAdjustment"/><picker range="{{adjustmentLabels}}" bindchange="onAdjustmentType"><view class="picker">{{adjustmentLabels[adjustmentType]}}</view></picker>
  </view>
  <button class="primary" bindtap="saveAndPreview" loading="{{saving}}" disabled="{{saving}}">保存账单并查看分账预览</button>
</view>