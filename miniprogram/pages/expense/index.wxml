<view class="page expense-page">
  <view wx:if="{{reading}}" class="expense-reading">
    <view class="masthead"><text class="kicker">消费详情</text><text class="reading-title">{{title}}</text><text class="expense-date">{{occurredAt}}</text></view>
    <view class="reading-total"><text>{{checkoutLabel}}</text><view><text class="reading-amount">¥{{checkoutAmount}}</text><text class="currency">{{checkoutCurrency}}</text></view><text wx:if="{{currency !== checkoutCurrency}}" class="reading-original">商品小计 ¥{{billTotal}} {{currency}}</text></view>
    <view class="reading-card"><text class="section-title">付款与结算</text><view class="reading-line"><text>付款人</text><text>{{payer}}</text></view><view class="reading-line"><text>结算方式</text><text wx:if="{{actualPaymentAmount}}">实际支付 {{actualPaymentAmount}} {{actualPaymentCurrency}}</text><text wx:elif="{{currency === settlementCurrency}}">原币结算</text><text wx:elif="{{referenceRate}}">1 {{currency}} = {{referenceRate}} {{settlementCurrency}}</text><text wx:else>待补充汇率</text></view></view>
    <view class="reading-card"><view class="list-heading"><text class="section-title">商品明细</text><text class="summary-note">共 {{items.length}} 项</text></view><view wx:for="{{items}}" wx:key="id" class="reading-item"><view><text class="reading-item-name">{{item.name || "未命名商品"}}</text><text class="compact-item-meta">{{item.allocationMode === 'payer' ? '付款人承担' : item.allocationMode === 'friend' ? '同行人承担' : item.allocationMode === 'split' ? '两人均分' : '自定义比例'}}</text></view><view><text class="compact-item-amount">¥{{item.amount}}</text><text class="currency">{{currency}}</text></view></view></view>
    <view wx:if="{{taxAmount || adjustmentAmount}}" class="reading-card"><text class="section-title">账单调整</text><view wx:if="{{taxAmount}}" class="reading-line"><text>税额</text><text>¥{{taxAmount}} {{currency}}</text></view><view wx:if="{{adjustmentAmount}}" class="reading-line"><text>{{adjustmentLabels[adjustmentType]}}</text><text>¥{{adjustmentAmount}} {{currency}}</text></view></view>
    <button class="reading-edit" bindtap="beginEditing">编辑此笔消费</button>
  </view>
  <view wx:else class="expense-editor">
  <view class="masthead">
    <text class="kicker">TRAVEL SPLIT</text>
    <input class="expense-title-input" value="{{title}}" bindinput="onTitle" placeholder="消费名称"/>
    <picker mode="date" value="{{occurredAt}}" bindchange="onOccurredAt"><view class="expense-date">{{occurredAt || "选择日期"}} ⌄</view></picker>
  </view>
  <view class="bill-summary">
    <view class="summary-head"><text class="section-title">同行信息</text><text class="summary-note">同行人可留空</text></view>
    <view class="people-grid">
      <view class="person-field"><text class="field-label">付款人</text><input placeholder="例如：我" value="{{payer}}" bindinput="onPayer"/></view>
      <view class="person-field"><text class="field-label">同行人</text><input placeholder="例如：小林" value="{{friend}}" bindinput="onFriend"/></view>
    </view>
  </view>
  <view class="receipt-section">
    <view class="receipt-copy"><text class="section-title">票据附件</text><text class="receipt-status">{{ocrStatus}}</text></view>
    <button class="receipt-button" bindtap="chooseReceipt">拍小票，记录消费</button>
    <image wx:if="{{receiptPath}}" class="receipt" src="{{receiptPath}}" mode="widthFix"/>
  </view>
  <view class="ticket-list">
    <view class="list-heading"><text class="section-title">商品条目</text><view class="list-actions"><text class="summary-note">共 {{items.length}} 项</text><text class="batch-toggle" bindtap="toggleBatchEditing">{{batchEditing ? "完成批量编辑" : "批量编辑"}}</text></view></view>
    <view class="expense-currency-row"><text class="field-label">消费币种</text><picker range="{{settlementCurrencies}}" value="{{currencyIndex}}" bindchange="onCurrency"><view class="expense-currency-picker">{{currency}}<text>⌄</text></view></picker></view>
    <view wx:if="{{showBatchTools && friend}}" class="batch-toolbar">
      <view class="batch-toolbar-heading"><text>已选 {{selectedCount}} 项</text><text class="batch-finish" bindtap="toggleBatchEditing">完成</text></view>
      <picker range="{{batchModes}}" value="{{batchModeIndex}}" bindchange="onBatchMode"><view class="batch-toolbar-picker">{{batchModes[batchModeIndex]}}<text class="chevron">⌄</text></view></picker>
      <view wx:if="{{batchModeIndex === 3}}" class="ratio-row"><input type="digit" value="{{batchPayerPercent}}" bindinput="onBatchPayerPercent"/><text>% 付款人</text><input type="digit" value="{{batchFriendPercent}}" bindinput="onBatchFriendPercent"/><text>% 同行人</text></view>
      <button class="batch-apply" bindtap="applyBatchAllocation">应用到已选商品</button>
    </view>
    <view class="item-ledger">
    <view wx:for="{{items}}" wx:key="id" class="ledger-row" data-id="{{item.id}}" bindtap="toggleItemDetail">
      <view class="compact-item-row"><checkbox wx:if="{{batchEditing}}" class="item-select" checked="{{item.selected}}" data-id="{{item.id}}" catchtap="toggleItem" color="#124954"/><view class="compact-item-copy"><text class="compact-item-name">{{item.name || "未命名商品"}}</text><text class="compact-item-meta">{{item.allocationMode === 'payer' ? '付款人自己买' : item.allocationMode === 'friend' ? '同行人自己买' : item.allocationMode === 'split' ? '两人均分' : '自定义比例'}}</text></view><view class="compact-item-total"><text class="compact-item-amount">¥{{item.amount || "0.00"}}</text><text class="currency">{{currency}}</text></view><text class="chevron">{{expandedItemId === item.id ? "⌃" : "›"}}</text></view>
      <view wx:if="{{expandedItemId === item.id}}" class="item-editor" catchtap="stopItemEditorTap">
        <input class="item-name" placeholder="商品名称，例如：晚餐" value="{{item.name}}" data-id="{{item.id}}" bindinput="onItemName"/>
        <view class="amount-row"><text class="currency-mark">¥</text><input class="amount-input" type="digit" placeholder="0.00" value="{{item.amount}}" data-id="{{item.id}}" bindinput="onItemAmount"/><text class="currency-code">{{currency}}</text></view>
        <picker wx:if="{{friend}}" range="{{batchModes}}" value="{{item.allocationMode === 'payer' ? 0 : item.allocationMode === 'friend' ? 1 : item.allocationMode === 'split' ? 2 : 3}}" data-id="{{item.id}}" bindchange="onItemMode"><view class="allocation-picker">{{item.allocationMode === 'payer' ? '付款人自己买' : item.allocationMode === 'friend' ? '同行人自己买' : item.allocationMode === 'split' ? '两人均分' : '自定义比例'}}<text class="chevron">⌄</text></view></picker>
        <text wx:else class="allocation-picker">付款人自己买</text>
        <view wx:if="{{item.allocationMode === 'custom'}}" class="ratio-row"><input type="digit" value="{{item.payerPercent}}" data-id="{{item.id}}" bindinput="onItemPayerPercent"/><text>% 付款人</text><input type="digit" value="{{item.friendPercent}}" data-id="{{item.id}}" bindinput="onItemFriendPercent"/><text>% 同行人</text></view>
        <button class="remove-button" size="mini" disabled="{{items.length === 1}}" data-id="{{item.id}}" catchtap="removeItem">删除商品</button>
      </view>
    </view></view>
    <button class="add-ticket" bindtap="addItem">+ 手动添加商品</button>
    <view class="expense-subtotal"><text>本次消费小计</text><view><text class="subtotal-value">¥{{billTotal}}</text><text class="subtotal-currency">{{currency}}</text></view></view>
    <view class="expense-settlement">
      <view class="settlement-row"><view><text class="section-title">本笔结算</text><text class="settlement-copy">一张小票使用一条结算规则</text></view><picker wx:if="{{!settlementCurrencyLocked}}" range="{{settlementCurrencies}}" value="{{settlementCurrencyIndex}}" bindchange="onSettlementCurrency"><view class="settlement-picker">{{settlementCurrency}} ⌄</view></picker><text wx:else class="settlement-locked">{{settlementCurrency}} 已锁定</text></view>
      <view class="rate-summary"><text wx:if="{{actualPaymentAmount}}">按实际支付 {{actualPaymentAmount}} {{actualPaymentCurrency}} 结算</text><text wx:elif="{{currency === settlementCurrency}}">原币种与结算币种相同</text><text wx:elif="{{referenceRate}}">1 {{currency}} = {{referenceRate}} {{settlementCurrency}} · {{rateEffectiveDate}}</text><text wx:else>未获取汇率</text></view>
      <text wx:if="{{estimatedSettlementAmount}}" class="estimate-copy">约 ¥{{estimatedSettlementAmount}} {{settlementCurrency}}（参考汇率）</text>
      <view class="payment-row"><text class="field-label">实际支付金额（可选）</text><input class="payment-input" type="digit" placeholder="例如 140.82" value="{{actualPaymentAmount || ''}}" data-currency="{{settlementCurrency}}" bindinput="onActualPaymentAmount"/><picker range="{{settlementCurrencies}}" value="{{actualPaymentCurrencyIndex}}" bindchange="onActualPaymentCurrency"><view class="payment-currency">{{actualPaymentCurrency || settlementCurrency}} ⌄</view></picker></view>
      <view wx:if="{{rateStatus === 'failed'}}" class="rate-failed"><text>未获取汇率，请重新查询或手动填写</text><button size="mini" class="rate-retry" bindtap="refreshRate">重新查询</button><input class="manual-rate" type="digit" placeholder="手动填写 1 {{currency}} 等于多少 {{settlementCurrency}}" value="{{referenceRate}}" bindinput="onManualRate"/></view>
    </view>
  </view>
  <view class="adjustment-section">
    <view class="list-heading" bindtap="toggleAdjustments"><text class="section-title">账单调整</text><text class="summary-note">{{showAdjustments ? "收起" : "可选"}}</text></view><view wx:if="{{showAdjustments}}">
    <view class="adjustment-row"><view><text class="field-label">税额</text><text class="small-note">商品金额{{taxIncluded ? "已含税" : "未含税"}}</text></view><switch checked="{{taxIncluded}}" bindchange="onTaxIncluded" color="#123E45"/></view>
    <input class="quiet-input adjustment-input" type="digit" placeholder="填写税额，例如 10" value="{{taxAmount}}" bindinput="onTax"/>
    <view class="adjustment-row"><text class="field-label">优惠 / 退款</text><picker range="{{adjustmentLabels}}" bindchange="onAdjustmentType"><view class="inline-picker">{{adjustmentLabels[adjustmentType]}}⌄</view></picker></view>
    <input class="quiet-input adjustment-input" placeholder="负数，例如 -20" value="{{adjustmentAmount}}" bindinput="onAdjustment"/>
  </view></view>
  <view class="checkout-bar">
    <view><text class="checkout-label">{{checkoutLabel}}</text><text class="checkout-total">¥{{checkoutAmount}}</text><text class="checkout-currency">{{checkoutCurrency}}</text></view>
    <button class="checkout-button" bindtap="saveAndPreview" loading="{{saving}}" disabled="{{saving}}">保存并查看分账</button>
  </view>
  </view>
</view>
